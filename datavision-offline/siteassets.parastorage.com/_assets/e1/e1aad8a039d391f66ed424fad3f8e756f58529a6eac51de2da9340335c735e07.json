er"}},"comp-mav9ajtr1":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">As a Software Developer, you will design cutting-edge solutions that optimize manufacturing processes and you&rsquo;ll take part in the core development of our products and applications. </span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">​</span></span></p>\n\n<h6 class=\"font_6 wixui-rich-text__text\" style=\"font-size:28px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span class=\"color_44 wixui-rich-text__text\">Your Role and Responsibilities</span></span></h6>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"color:rgb(204, 204, 204); font-size:16px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Software development within the R&amp;D team focused on creating innovative solutions.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Participation in the application design process.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Implementation of backend technical solutions for image processing and AI.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Proficiency in unit testing and ensuring high-quality code delivery.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Technical scope includes expertise in software development and automated testing.</span></p>\n</li>\n</ul>\n\n<h6 class=\"font_6 wixui-rich-text__text\" style=\"font-size:28px;\">&nbsp;</h6>\n\n<h6 class=\"font_6 wixui-rich-text__text\" style=\"font-size:28px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span class=\"color_44 wixui-rich-text__text\">Position Requirements</span></span></h6>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"color:rgb(204, 204, 204); font-size:16px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Proficiency in C#.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0em;\" class=\"wixui-rich-text__text\">Knowledge of software design and architectural patterns.</span></li>\n<li class=\"wixui-rich-text__text\">Analytical and problem-solving skills.</li>\n<li class=\"wixui-rich-text__text\">Open-minded team player.</li>\n</ul>\n\n<p class=\"wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">​</span></p>\n\n<p class=\"wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">​</span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"color:rgb(204, 204, 204); font-size:16px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Nice-to-have:</span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"color:rgb(204, 204, 204); font-size:16px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Knowledge of ASP .NET Core, REST API, and Docker container.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Experience with FE technologies (Angular, Blazor).</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Experience with Linux, CI/CD tools like Jenkins, Version Control tools like Git, and Code review tools like Gerrit.</span></p>\n</li>\n</ul>\n</li>\n</ul>\n\n<h6 class=\"font_6 wixui-rich-text__text\" style=\"font-size:28px;\">&nbsp;</h6>\n\n<h6 class=\"font_6 wixui-rich-text__text\" style=\"font-size:28px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span class=\"color_44 wixui-rich-text__text\">Minimum Education and Experience</span></span></h6>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"color:rgb(204, 204, 204); font-size:16px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Education in Engineering or Computer Science or adequate professional background.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">At least 5 years of programming experience.</span></p>\n</li>\n</ul>\n\n<h6 class=\"font_6 wixui-rich-text__text\" style=\"font-size:28px;\">&nbsp;</h6>\n\n<h6 class=\"font_6 wixui-rich-text__text\" style=\"font-size:28px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span class=\"color_44 wixui-rich-text__text\">What We Offer</span></span></h6>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"color:rgb(204, 204, 204); font-size:16px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Inspiring a work environment within a collaborative team.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Opportunities for professional growth and career advancement in IT.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Flexible working hours, home office options, and 5 weeks of vacation.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">3 extra days off for personal matters, such as administrative tasks or sick days.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Regular grill parties on the company terrace.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Competitive compensation based on performance.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Company contribution to the Multisport card.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Language courses.</span></p>\n</li>\n</ul>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#CCCCCC;\" class=\"wixui-rich-text__text\">Join us at DataVision to shape the future of industrial automation through cutting-edge machine vision technologies! For more information about us, contact Martina Ha&scaron;kov&aacute; <span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\">+420 737 240 516,&nbsp;</span><a data-auto-recognition=\"true\" href=\"mailto:martina.haskova@datavision.cz\" class=\"wixui-rich-text__text\">martina.haskova@datavision.cz</a></span><span class=\"wixui-rich-text__text\">​</span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mav9ajtm3":{"html":"<h3 class=\"font_6 wixui-rich-text__text\" style=\"font-size:30px; line-height:normal;\"><span class=\"color_44 wixui-rich-text__text\"><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:wfont_aeceae_22b52e19216244fea64b5b5594d37f6e,wf_22b52e19216244fea64b5b559,orig_roboto_regular;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\">C# Software Developer</span></span></span></span></span></h3>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"}}}},"nicknameToCompIdMaps":{}}